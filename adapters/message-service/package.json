{
  "name": "@waesim/message-service",
  "type": "module",
  "exports": {
    "./*.js": {
      "import": "./dist/*.js",
      "types": "./dist/*.d.ts"
    },
    "./*": {
      "import": "./dist/*/index.js",
      "types": "./dist/*/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "dep-watcher -c 'pnpm build' src node_modules/@waesim/*/dist",
    "clean": "rm -rf ./dist/*"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@types/qrcode-terminal": "^0.12.2",
    "@waesim/application": "workspace:^",
    "@waesim/domain": "workspace:^",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "effect": "catalog:",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "tsc-alias": "^1.9.8"
  }
}
