{
  "$schema": "node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": false,
  "sortImports": {
    "newlinesBetween": true,
    "customGroups": [
      {
        "groupName": "effect-vitest",
        "elementNamePattern": ["@effect/vitest", "@effect/vitest/**"]
      },
      { "groupName": "effect", "elementNamePattern": ["effect", "effect/**"] },
      { "groupName": "effect-scoped", "elementNamePattern": ["@effect/**"] },
      { "groupName": "repo-domain", "elementNamePattern": ["@repo/domain/**"] },
      { "groupName": "repo-application", "elementNamePattern": ["@repo/application/**"] },
      { "groupName": "repo", "elementNamePattern": ["@repo/**"] },
      { "groupName": "alias", "elementNamePattern": ["@/**"] }
    ],
    "groups": [
      "effect-vitest",
      "effect",
      "effect-scoped",
      "repo-domain",
      "repo-application",
      "repo",
      "builtin",
      "external",
      "alias",
      { "newlinesBetween": false },
      ["internal", "parent", "sibling", "index"],
      "unknown"
    ]
  }
}
